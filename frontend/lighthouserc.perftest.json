{
  "$comment": [
    "Lighthouse CI config — perftest Worker variant of lighthouserc.json.",
    "",
    "Runs the same three URLs / 3-runs-each / desktop preset as the prod",
    "config, but against sports-perftest.unseen-university.workers.dev.",
    "Used in 3C task #78 to compare all-Cloudflare scores to the droplet",
    "baseline before 3D cutover.",
    "",
    "Delete this file after the perftest Worker is decommissioned",
    "(post-3E)."
  ],
  "ci": {
    "collect": {
      "url": [
        "https://sports-perftest.unseen-university.workers.dev/cfb/",
        "https://sports-perftest.unseen-university.workers.dev/cfb/game/401403910",
        "https://sports-perftest.unseen-university.workers.dev/cfb/year/2024/teams/differential"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance":    ["error", {"minScore": 0.40}],
        "largest-contentful-paint":  ["warn",  {"maxNumericValue": 4000}],
        "first-contentful-paint":    ["warn",  {"maxNumericValue": 2000}],
        "speed-index":               ["warn",  {"maxNumericValue": 6000}],
        "total-byte-weight":         ["warn",  {"maxNumericValue": 10000000}],
        "cumulative-layout-shift":   ["warn",  {"maxNumericValue": 0.1}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
