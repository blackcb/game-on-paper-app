# Sub-phase 2H: public Python endpoint for the Cloudflare Worker.
#
# The Worker (sports.unseen-university.org, served from CF edge)
# can't reach the Docker-internal `python:7000` hostname. This vhost
# exposes /cfb/process publicly at https://python.sports.unseen-university.org,
# gated on a shared-secret header so only the Worker can hit it.
#
# Source of truth lives in this repo. The fork-deploy.yml workflow
# substitutes ${WORKER_SHARED_SECRET} (from a GitHub Actions secret)
# at deploy time and writes the rendered file into
# /etc/caddy/conf.d/ on the droplet. The existing /etc/caddy/Caddyfile
# imports anything in conf.d/ via `import conf.d/*.caddy`, set up
# once during the 2H bring-up.
#
# Rotation: update the WORKER_SHARED_SECRET GitHub Actions secret,
# update the Wrangler secret to match (`echo -n "$NEW" | wrangler
# secret put WORKER_SHARED_SECRET`), push to the fork branch — CI
# does the rest.

python.sports.unseen-university.org {
    # Header matcher: requests must carry X-Worker-Secret with the
    # configured value. The literal string is templated in at deploy
    # time by envsubst, so the file in this repo never carries the
    # actual secret.
    @worker_auth header X-Worker-Secret ${WORKER_SHARED_SECRET}

    # Authorized requests proxy to the Python container.
    # The Python service binds port 7000 to 127.0.0.1 in
    # docker-compose.fork.yml so it's reachable from the host
    # (where systemd-managed Caddy runs) without being exposed
    # to the public internet — and the X-Worker-Secret check
    # above already gates anyone who reaches Caddy.
    handle @worker_auth {
        reverse_proxy 127.0.0.1:7000
    }

    # Anything else (no header, wrong header) gets a flat 403 with
    # no proxy attempt. Keeps unauthenticated traffic from ever
    # reaching the Python pipeline.
    handle {
        respond "Forbidden" 403
    }

    # Reuses the Cloudflare Origin Cert from
    # docs/replica-deploy-plan.md Phase C — it covers
    # *.sports.unseen-university.org + sports.unseen-university.org,
    # so this subdomain (python.sports.unseen-university.org) is
    # automatically in scope under the wildcard without re-issuing
    # the cert. Hostname intentionally chosen to fit the existing
    # cert; if we ever move to python.unseen-university.org the cert
    # has to be regenerated.
    #
    # Cert path matches the existing sports.unseen-university.org
    # block in /etc/caddy/Caddyfile (`/etc/caddy/certs/origin.{pem,key}`).
    tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

    # Access logs flow through Caddy's default output (stderr →
    # systemd journal) so we don't have to provision and chown a
    # /var/log/caddy/ directory specifically for this vhost (the
    # existing sports.unseen-university.org block doesn't have
    # an explicit log directive either, so /var/log/caddy/ may
    # not exist on the droplet). Filter via:
    #   journalctl -u caddy -f | jq 'select(.request.host == "python.sports.unseen-university.org")'
    log {
        format json
    }
}
