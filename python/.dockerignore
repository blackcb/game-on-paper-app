# Local dev/test artifacts that shouldn't ship in the image.
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test code is not used at runtime; integration tests hit real APIs
# and would inflate the image and slow `docker build` cache misses.
tests/
# …but fixtures ARE used at runtime by /cfb/process/replay (the
# load-test synthetic-in-progress endpoint). The negation re-includes
# the captured fixture trees while keeping conftest.py / test_*.py
# excluded. ~15 MB total across 3 games — acceptable for a load-test
# affordance, since Cloudflare Containers don't support volume mounts.
!tests/fixtures/
!tests/fixtures/**

# Tooling that builds fixtures or schemas — used out-of-band.
scripts/

# Documentation does not run.
README.md

# requirements-dev.txt is intentionally NOT excluded — present in
# the build context so future Dockerfile stages can install dev
# tooling if needed, but the current Dockerfile does not pull it in.
